datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique // External Auth ID
  handle    String   @unique
  email     String
  avatarUrl String?
  createdAt DateTime @default(now())
  
  posts     Post[]
  votes     Vote[]
}

model Post {
  id        String   @id @default(cuid())
  prompt    String
  style     String   @default("apple-min") // Store the style used
  dsl       Json     // The generated UIDSL JSON structure
  version   String   @default("1")
  createdAt DateTime @default(now())
  
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  
  votes     Vote[]
  
  // Denormalized counters for high-read performance
  upvoteCount   Int @default(0)
  downvoteCount Int @default(0)

  @@index([userId])
}

model Vote {
  userId String
  postId String
  type   String // "UP" or "DOWN"
  
  user   User @relation(fields: [userId], references: [id])
  post   Post @relation(fields: [postId], references: [id])

  @@id([userId, postId]) // Prevent double voting
}